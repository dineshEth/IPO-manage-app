generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(cuid())
  username  String    @unique
  password  String
  name      String?
  role      Role      @default(USER)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  ipoEntries IPOEntry[]
}

model IPO {
  id           String    @id @default(cuid())
  name         String
  symbol       String
  startDate    DateTime
  endDate      DateTime
  rumorGMP     Float?
  price        Float
  lotSize      Int
  costInRupees Float
  status       IPOStatus @default(PENDING)
  listingDate  DateTime?
  allotmentDate DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdBy    User      @relation(fields: [createdById], references: [id])
  createdById  String
  entries      IPOEntry[]
}

model IPOEntry {
  id           String       @id @default(cuid())
  ipo          IPO          @relation(fields: [ipoId], references: [id])
  ipoId        String
  user         User         @relation(fields: [userId], references: [id])
  userId       String
  upiId        String
  appliedDate  DateTime     @default(now())
  status       EntryStatus  @default(PENDING)
  allotmentStatus AllotmentStatus?
  requestedDeletion Boolean @default(false)
  deletionApproved Boolean @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([ipoId, userId])
}

enum Role {
  SUPER_ADMIN
  USER
}

enum IPOStatus {
  PENDING
  ACTIVE
  CLOSED
}

enum EntryStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum AllotmentStatus {
  ALLOTED
  NOT_ALLOTED
}
