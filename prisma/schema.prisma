generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(cuid())
  username  String    @unique
  password  String
  name      String?
  role      String    @default("USER")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  ipoEntries IPOEntry[]
  createdIPOs IPO[]
}

model IPO {
  id           String    @id @default(cuid())
  name         String
  symbol       String
  startDate    DateTime
  endDate      DateTime
  rumorGMP     Float?
  price        Float
  lotSize      Int
  costInRupees Float
  status       String    @default("PENDING")
  listingDate  DateTime?
  allotmentDate DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdBy    User      @relation(fields: [createdById], references: [id])
  createdById  String
  entries      IPOEntry[]
}

model IPOEntry {
  id           String   @id @default(cuid())
  ipo          IPO      @relation(fields: [ipoId], references: [id])
  ipoId        String
  user         User     @relation(fields: [userId], references: [id])
  userId       String
  upiId        String
  appliedDate  DateTime @default(now())
  status       String   @default("PENDING")
  allotmentStatus String?
  requestedDeletion Boolean @default(false)
  deletionApproved Boolean @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([ipoId, userId])
}


